# Function to compute out-the-door price
def compute_price(msrp, make, model, electric_code):

    # Determine discount rate
    if make == "Honda" and model == "Accord":
        discount_rate = 0.10
    elif make == "Toyota" and model == "Rav4":
        discount_rate = 0.15
    elif electric_code == "Y":
        discount_rate = 0.30
    else:
        discount_rate = 0.05

    # Calculate discounted price
    discount_amount = msrp * discount_rate
    new_msrp = msrp - discount_amount

    # Add sales tax
    sales_tax = new_msrp * 0.07
    total_price = new_msrp + sales_tax

    return total_price

 # Initialize accumulators
 total_msrp = 0
 total_sales_price = 0

 # Loop control
 answer = input("Do you want to enter a vehicle? (Yes or No): ")

 while answer == "Yes":

     # Input vehicle infomation
     make = input("Enter make: ")
     model = input("Enter model: ")
     electric_code = input("Is it an electric vehicle? (Y or N): ")
     msrp = float(input("Enter MSRP: "))

     # Call function
     sales_price = compute_price(msrp, make, model. electric_code)

     # Update totals
     print("\nVehicle Infomation")
     print("Make:", make)
     print("Model:", model)
     print("Electric Vehicle:", electric_code)
     print("MSRP: $", format(msrp, ",.2f"))
     print("Out-the-Door Price: $", format(sales_price, ",.2f"))

     # Continue?
     answer = input("\nDo you want to enter another vehicle? (Yes or No): ")

# Display summary
print("\nSummary")
print("Total MSRP: $", format(total_msrp, ",.2f"))
print("Total Sales Price: $", format(total_sales_price, ",.2f"))
